{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue Studio",
  "version": "2.5.2",
  "identifier": "studio.cue.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:prepare",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","create":false,"title":"Cue Studio","width":1440,"height":960,"minWidth":900,"minHeight":640,"url":"desktop.html"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"}
  },
  "bundle": {"active":true,"targets":["deb","appimage"],"icon":["icons/icon.png"],"linux":{"deb":{"depends":["python3","python3-venv","build-essential","git","libportaudio2","libsndfile1","ffmpeg","libgl1"]}},"resources":{"runtime/":"runtime/","web/":"web/"}}
}
